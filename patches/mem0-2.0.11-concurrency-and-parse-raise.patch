+    def _search_keyword_store(self, query, filters, limit, threshold=0.1, show_expired=False):
+        """Pure BM25 keyword retrieval (official CLI ``--keyword`` semantics).
+
+        Skips dense embedding, semantic search, and entity boosts entirely;
+        results are ranked by normalized BM25 score alone.
+        """
+        query_lemmatized = lemmatize_for_bm25(query)
+        internal_limit = max(limit * 4, 60)
+
+        keyword_results = self.vector_store.keyword_search(
+            query=query_lemmatized, top_k=internal_limit, filters=filters
+        )
+        if keyword_results is None:
+            raise ValueError("Keyword search is not available: the vector store has no BM25 index")
+
+        midpoint, steepness = get_bm25_params(query, lemmatized=query_lemmatized)
+
+        scored = []
+        for mem in keyword_results:
+            payload = mem.payload if hasattr(mem, "payload") else {}
+            if not payload or not payload.get("data"):
+                continue
+            if not show_expired and _payload_is_expired(payload):
+                continue
+            raw_score = mem.score if hasattr(mem, "score") else 0
+            if not raw_score or raw_score <= 0:
+                continue
+            score = normalize_bm25(raw_score, midpoint, steepness)
+            if threshold is not None and score < threshold:
+                continue
+            scored.append({"id": str(mem.id), "score": score, "payload": payload})
+
+        scored.sort(key=lambda c: c["score"], reverse=True)
+        scored = scored[:limit]
+
+        promoted_payload_keys = [
+            "user_id",
+            "agent_id",
+            "run_id",
+            "actor_id",
+            "role",
+            "attributed_to",
+            "expiration_date",
+        ]
+        core_and_promoted_keys = {"data", "hash", "created_at", "updated_at", "id", "text_lemmatized", "attributed_to", *promoted_payload_keys}
+
+        original_memories = []
+        for item in scored:
+            payload = item["payload"]
+            memory_item_dict = MemoryItem(
+                id=item["id"],
+                memory=payload.get("data", ""),
+                hash=payload.get("hash"),
+                created_at=payload.get("created_at"),
+                updated_at=payload.get("updated_at"),
+                score=item["score"],
+            ).model_dump()
+
+            for key in promoted_payload_keys:
+                if key in payload:
+                    memory_item_dict[key] = payload[key]
+
+            additional_metadata = {k: v for k, v in payload.items() if k not in core_and_promoted_keys}
+            if additional_metadata:
+                if not memory_item_dict.get("metadata"):
+                    memory_item_dict["metadata"] = {}
+                memory_item_dict["metadata"].update(additional_metadata)
+
+            original_memories.append(memory_item_dict)
+
+        return original_memories
